<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_invoice_save_before">
        <observer name="blueprint3d_date_order_numbers_invoice"
                  instance="BluePrint3D\DateOrderNumbers\Observer\ShareDocumentNumber"/>
    </event>
    <event name="sales_order_shipment_save_before">
        <observer name="blueprint3d_date_order_numbers_shipment"
                  instance="BluePrint3D\DateOrderNumbers\Observer\ShareDocumentNumber"/>
    </event>
    <event name="sales_order_creditmemo_save_before">
        <observer name="blueprint3d_date_order_numbers_creditmemo"
                  instance="BluePrint3D\DateOrderNumbers\Observer\ShareDocumentNumber"/>
    </event>
</config>
