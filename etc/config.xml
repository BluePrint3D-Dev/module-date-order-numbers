<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <blueprint3d_order_numbers>
            <general>
                <enabled>0</enabled>
                <mode>sequential</mode>
                <date_format>Ymd</date_format>
                <separator>-</separator>
                <counter_padding>3</counter_padding>
                <random_length>4</random_length>
                <share_numbers>1</share_numbers>
            </general>
            <prefixes>
                <order></order>
                <invoice></invoice>
                <shipment></shipment>
                <creditmemo></creditmemo>
            </prefixes>
        </blueprint3d_order_numbers>
    </default>
</config>
